{
  "name": "@wizard/server",
  "private": true,
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:latest": "tsx src/db/migrate.ts latest",
    "migrate:rollback": "tsx src/db/migrate.ts rollback"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "knex": "^3.1.0",
    "pg": "^8.11.5",
    "pino": "^9.1.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "pino-pretty": "^11.0.0",
    "tsx": "^4.10.5"
  }
}
