# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wizard
# Long random string used to sign session cookies
SESSION_SECRET=change-me
# Bearer token required to scrape /api/v1/metrics
PROMETHEUS_TOKEN=change-me
# development | production
NODE_ENV=development
# Optional: HTTP port (defaults to 3000)
PORT=3000
# Production only: the single origin CORS allows, e.g. https://wizard.example.com
# APP_ORIGIN=
# Optional: reverse-proxy hops to trust for client IPs (default 1 in production, 0 otherwise)
# TRUST_PROXY_HOPS=
